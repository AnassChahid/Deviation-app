# True for local development, False for shared testing/prod deployments.
DEBUG=False

FLASK_APP=run.py
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000

# Required when DEBUG=False.
SECRET_KEY=replace-with-a-long-random-production-secret

# Static asset root. No slash at the end.
ASSETS_ROOT=/static/assets

# FastAPI backend.
BACKEND_API_URL=http://backend-host:8001
FRONTEND_AUTH_MODE=backend
