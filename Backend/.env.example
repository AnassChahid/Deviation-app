APP_NAME="Port Deviation Management API"
SECRET_KEY="change-this-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQL Server LocalDB using Windows Authentication.
# This matches SSMS server name: (localdb)\mssqllocaldb
DATABASE_URL="mssql+pyodbc:///?odbc_connect=Driver%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BServer%3D%28localdb%29%5Cmssqllocaldb%3BDatabase%3DDeviationDb%3BTrusted_Connection%3Dyes%3BTrustServerCertificate%3Dyes"
