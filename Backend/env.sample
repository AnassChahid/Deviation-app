APP_NAME=Port Deviation Management API

# SQL Server connection string. Create the production database before startup.
DATABASE_URL=mssql+pyodbc:///?odbc_connect=Driver%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BServer%3Dsql-server-host%3BDatabase%3DDeviationDb%3BUID%3Dapp_user%3BPWD%3Dstrong_password%3BTrustServerCertificate%3Dyes

# Generate a unique strong value with at least 32 characters.
SECRET_KEY=replace-with-a-long-random-production-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Keep API docs disabled in production. Set True only for local/testing.
ENABLE_API_DOCS=False

# Keep database creation disabled in production. Set True only for local/testing
# when running the manual initializer and the SQL Server login has permission
# to create databases.
AUTO_CREATE_DATABASE=False

# Keep startup migrations disabled in production. Set True only for local/testing
# if you intentionally want app startup to run the compatibility initializer.
RUN_STARTUP_MIGRATIONS=False
