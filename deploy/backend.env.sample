APP_NAME=Port Deviation Management API

# Use the real SQL Server address. Inside Docker, localhost means the container.
# If SQL Server runs on 10.212.12.201, keep Server=10.212.12.201 or the SQL host name.
DATABASE_URL=mssql+pyodbc:///?odbc_connect=Driver%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BServer%3D10.212.12.201%3BDatabase%3DDeviationDb%3BUID%3Dapp_user%3BPWD%3Dstrong_password%3BTrustServerCertificate%3Dyes

SECRET_KEY=replace-with-a-long-random-production-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENABLE_API_DOCS=False
AUTO_CREATE_DATABASE=False
RUN_STARTUP_MIGRATIONS=False
